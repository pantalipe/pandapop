; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PandaPop"
config/description="A desktop companion panda by PandaPoints"
run/main_scene="res://scenes/OverlayMain.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://assets/sprites/icon.png"

[autoload]

GameManager="*res://scripts/game_manager.gd"

[display]

window/size/viewport_width=220
window/size/viewport_height=220
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/stretch/mode="disabled"
window/subwindows/embedded_subwindows=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
